---
interface Props {
  title: string;
  description: string;
  tags?: string[];
  link?: string;
}

const { title, description, tags = [], link } = Astro.props;

const accentPalette = [
  ['#01696f', '#4f98a3'],
  ['#9f6b2f', '#d9a857'],
  ['#6b4fae', '#a98fe0'],
  ['#2f8f5b', '#7fd6a0'],
  ['#ae3f5b', '#e08aa0'],
];

function hashString(value: string) {
  let hash = 0;
  for (let i = 0; i < value.length; i += 1) {
    hash = (hash << 5) - hash + value.charCodeAt(i);
    hash |= 0;
  }
  return Math.abs(hash);
}

const [accentFrom, accentTo] = accentPalette[hashString(title) % accentPalette.length];
---

<article class="project-card">
  <div class="card-topline" style={`background: linear-gradient(90deg, ${accentFrom}, ${accentTo})`}></div>
  <h3 class="card-title">{title}</h3>
  <p class="card-description">{description}</p>

  {tags.length > 0 && (
    <div class="card-tags">
      {tags.map((tag) => (
        <span class="tag">{tag}</span>
      ))}
    </div>
  )}

  {link && (
    <a href={link} target="_blank" rel="noreferrer noopener" class="card-link">
      View Project
    </a>
  )}
</article>

<style>
  .project-card {
    position: relative;
    background-color: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 1rem;
    padding: 1.75rem 1.5rem 1.5rem;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    transition: box-shadow 180ms ease, transform 180ms ease;
    box-shadow: var(--shadow-sm);
  }

  .card-topline {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 0.3rem;
    margin-bottom: 1.25rem;
  }

  .project-card:hover {
    box-shadow: var(--shadow-md);
    transform: translateY(-2px);
  }

  .card-title {
    font-family: var(--font-display);
    font-size: var(--text-lg);
    margin-bottom: 0.75rem;
  }

  .card-description {
    color: var(--color-text-muted);
    font-size: var(--text-base);
    margin-bottom: 1rem;
    max-width: none;
  }

  .card-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: 1rem;
  }

  .tag {
    display: inline-flex;
    align-items: center;
    font-size: var(--text-xs);
    background-color: var(--color-surface-offset);
    color: var(--color-text-muted);
    padding: 0.375rem 0.75rem;
    border-radius: 9999px;
  }

  .card-link {
    align-self: flex-start;
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    color: var(--color-text);
    background-color: var(--color-surface-offset);
    border: 1px solid var(--color-border);
    padding: 0.5rem 0.9rem;
    border-radius: 0.5rem;
    font-size: var(--text-sm);
    font-weight: 500;
    text-decoration: none;
    transition: background-color 180ms ease, color 180ms ease, border-color 180ms ease;
    margin-top: auto;
  }

  .card-link::after {
    content: '↗';
  }

  .card-link:hover {
    background-color: var(--color-primary);
    color: #fff;
    border-color: var(--color-primary);
  }
</style>
